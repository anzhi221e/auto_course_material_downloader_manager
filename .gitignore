canvas_manifest.json
canvas_manifest*.json

# 抓取时记下的「文件名 -> 标题/课程/周次」，含课程结构
file_titles.json

# 搬运流水账，含绝对路径和用户名
moves_log.csv

# 本地路径、下载夹位置
config.json

# syllabus 的完整摘录。这是老师的作品，版权上属灰区，不要公开
readings_index.json

# 你自己的课程/学期配置（从 courses.example.json 复制一份改）
courses.json

# Canvas 访问令牌（本项目不再使用，保险起见仍然排除）
.canvas_token
*.token

